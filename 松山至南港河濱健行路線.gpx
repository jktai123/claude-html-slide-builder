<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Antigravity Coding Assistant" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>松山捷運站-內湖復育園區-南港LaLaport河濱健行路線</name>
    <desc>從捷運松山站出發，跨越彩虹橋至右岸，沿河濱行經成美橋、成功橋、內湖復育園區，最後由南湖大橋跨回左岸，抵達南港 LaLaport。全長約 7.5~8 公里，適合8人團體健行與單車活動。</desc>
    <author>
      <name>Antigravity</name>
    </author>
    <time>2026-07-15T05:42:00Z</time>
  </metadata>
  <trk>
